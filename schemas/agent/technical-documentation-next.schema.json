{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oduit.dev/schemas/agent/technical-documentation-next.schema.json",
  "type": "object",
  "required": ["type", "data"],
  "properties": {
    "type": {
      "const": "technical_documentation_next"
    },
    "data": {
      "type": "object",
      "required": ["next_module", "scanned_count", "stale_count"],
      "properties": {
        "next_module": {
          "type": ["string", "null"]
        },
        "status": {
          "type": ["object", "null"]
        },
        "scanned_count": {
          "type": "integer"
        },
        "stale_count": {
          "type": "integer"
        },
        "include_files": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
