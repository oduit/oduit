{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oduit.dev/schemas/agent/i18n-export.schema.json",
  "type": "object",
  "required": ["type", "data"],
  "properties": {
    "type": {
      "const": "i18n_export"
    },
    "data": {
      "type": "object",
      "required": ["modules", "languages"],
      "properties": {
        "modules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "output": {
          "type": ["string", "null"]
        },
        "odoo_series": {
          "type": ["string", "null"]
        },
        "strategy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
