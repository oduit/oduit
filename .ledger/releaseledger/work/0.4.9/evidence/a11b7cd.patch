+    @staticmethod
+    def _native_db_command_unavailable(output: str) -> bool:
+        lowered = output.lower()
+        command_error = any(
+            marker in lowered
+            for marker in (
+                "unknown command",
+                "invalid choice",
+                "no such command",
+                "unrecognized arguments",
+            )
