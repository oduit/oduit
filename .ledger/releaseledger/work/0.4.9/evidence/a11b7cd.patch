+                target_database,
+                neutralize=neutralize,
+                force=force,
+            ),
+            operation="duplicate_database",
+            error_type="BranchDatabaseDuplicateError",
+            result_fields=fields,
+            suppress_output=suppress_output,
+            raise_on_error=raise_on_error,
+            odoo_series=odoo_series,
