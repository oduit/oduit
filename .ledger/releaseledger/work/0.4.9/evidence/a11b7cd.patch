+                    "database": database,
+                    "source_database": source_database,
+                    "neutralize": neutralize,
+                    "force": force,
+                },
+            )
+        )
+        if database in self.existing_databases:
+            return {"success": False, "error": "Database already exists"}
+        self.existing_databases.add(database)
+        return {"success": True}
