+        """Extract actionable PostgreSQL extension prerequisite failures."""
+        lowered = output.lower()
+        errors: list[dict[str, str]] = []
+        extension_names = re.findall(
+            r"extension\s+[\"']([^\"']+)[\"']", output, re.IGNORECASE
+        )
